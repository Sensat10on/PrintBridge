# Copy to keystore.properties (repository root, git-ignored) and fill in real values.
# keystore.properties is read by app/build.gradle.kts; the same values can be supplied
# through the PRINTBRIDGE_* environment variables or -P Gradle properties instead.
storeFile=release-keystore.jks
storePassword=change-me
keyAlias=printbridge
keyPassword=change-me
